# ---- Server environment (placeholders only — never commit real .env) ----

# Runtime
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=

# Auth (JWT_SECRET must be >= 32 chars in production)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS / Client origins
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Email Delivery Service (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VYBE Platform <no-reply@vybe.dev>"

# Cloudinary CDN
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin seed
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
